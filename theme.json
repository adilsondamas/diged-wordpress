  "styles": {
    "spacing": {
      "padding": {
        "left": "var:preset|spacing|40",
        "right": "var:preset|spacing|40"
      },
      "blockGap": "var:preset|spacing|50"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|primary",
      "fontSize": "var:preset|font-size|body",
      "fontWeight": "400",
      "lineHeight": "1.55"
    },
    "color": {
      "text": "var:preset|color|graphite",
      "background": "var:preset|color|white"
    },
    "elements": {
      "heading": {
        "color": {
          "text": "var:preset|color|black"
        },
        "typography": {
          "fontWeight": "600",
          "lineHeight": "1.2",
          "letterSpacing": "0em"
        }
      },
      "link": {
        "color": {
          "text": "var:preset|color|brand"
        },
        "typography": {
          "textDecoration": "underline"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var:preset|font-size|h1",
          "fontWeight": "600",
          "lineHeight": "1",
          "letterSpacing": "-0.02em"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var:preset|font-size|h2",
          "fontWeight": "600",
          "lineHeight": "1.05",
          "letterSpacing": "-0.02em"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var:preset|font-size|h3",
          "fontWeight": "600",
          "lineHeight": "1.15",
          "letterSpacing": "0em"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "var:preset|font-size|h4",
          "fontWeight": "600",
          "lineHeight": "1.2",
          "letterSpacing": "0em"
        }
      },
      "h5": {
        "typography": {
          "fontSize": "var:preset|font-size|body",
          "fontWeight": "600",
          "lineHeight": "1.2",
          "letterSpacing": "0em"
        }
      },
      "h6": {
        "typography": {
          "fontSize": "var:preset|font-size|small",
          "fontWeight": "600",
          "lineHeight": "1.2",
          "letterSpacing": "0em"
        }
      },
      "button": {
        "typography": {
          "fontFamily": "var:preset|font-family|primary",
          "fontSize": "var:preset|font-size|button",
          "fontWeight": "600",
          "lineHeight": "1.2",
          "letterSpacing": "0em"
        }
      }
    },
    "css": ".has-display-xl-font-size { font-weight: 600; line-height: 0.92; letter-spacing: -0.03em; }\n.has-display-font-size { font-weight: 600; line-height: 0.95; letter-spacing: -0.03em; }\n.has-h1-font-size { font-weight: 600; line-height: 1; letter-spacing: -0.02em; }\n.has-h2-font-size { font-weight: 600; line-height: 1.05; letter-spacing: -0.02em; }\n.has-h3-font-size { font-weight: 600; line-height: 1.15; letter-spacing: 0em; }\n.has-h4-font-size { font-weight: 600; line-height: 1.2; letter-spacing: 0em; }\n.has-lead-font-size { font-weight: 400; line-height: 1.4; letter-spacing: 0em; }\n.has-body-l-font-size { font-weight: 400; line-height: 1.5; letter-spacing: 0em; }\n.has-body-font-size { font-weight: 400; line-height: 1.55; letter-spacing: 0em; }\n.has-small-font-size { font-weight: 400; line-height: 1.45; letter-spacing: 0em; }\n.has-label-font-size { font-weight: 600; line-height: 1.2; letter-spacing: 0em; }\n.has-button-font-size { font-weight: 600; line-height: 1.2; letter-spacing: 0em; }"
